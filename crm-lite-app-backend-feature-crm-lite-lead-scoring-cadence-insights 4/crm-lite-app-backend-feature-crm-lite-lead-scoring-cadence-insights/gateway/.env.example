# Copy to .env (or export these directly) for local development.

# Where the FastAPI backend (crm-lite-app-backend) is listening.
BACKEND_BASE_URL=http://localhost:8000

# Must match the backend's GATEWAY_EMPLOYEE_HEADER / GATEWAY_ROLES_HEADER
# (defaults on both sides already agree — only change if you changed one).
GATEWAY_EMPLOYEE_HEADER=X-Employee-Id
GATEWAY_ROLES_HEADER=X-Roles

# HS256 shared secret used to verify the Authorization: Bearer JWT on every
# proxied request (see scripts/mint_test_jwt.py to mint one for testing).
# CHANGE THIS outside local dev.
JWT_SECRET=crm-lite-gateway-dev-secret-key-please-change-2026

# Origins allowed to call this gateway from a browser (comma-separated).
GATEWAY_CORS_ORIGINS=http://localhost:3000

PORT=8080
