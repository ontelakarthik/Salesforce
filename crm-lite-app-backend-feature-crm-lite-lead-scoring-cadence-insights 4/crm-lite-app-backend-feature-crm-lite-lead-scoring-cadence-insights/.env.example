# Copy to .env for local development. Every value here is read from the
# environment at startup (src/config/config.py) — nothing is hardcoded in
# source, so a real deployment sets these via its own secrets/config
# mechanism (Key Vault, App Configuration, container env vars, ...) instead
# of shipping a .env file.
APP_NAME=crm-lite-service
APP_ENV=local
API_PREFIX=/api/v1
LOG_LEVEL=INFO

# Postgres only. The value below matches docker-compose.yml's local
# container (docker compose up -d) — fine for local dev. In staging/
# production this points at a managed Postgres instance (e.g. Azure
# Database for PostgreSQL) with real, secret-store-issued credentials —
# same URL scheme, no code change, just a different value injected by
# the deployment environment.
DATABASE_URL=postgresql+psycopg://crmlite:crmlite@localhost:5433/crmlite

# Origins allowed to call this API directly from the browser (comma-aware
# JSON-style list). No gateway in front to set Access-Control-* itself
# anymore — see src/server/__init__.py.
CORS_ORIGINS=["http://localhost:3000"]

# No gateway in front — this service verifies its own signed bearer tokens
# (POST /auth/login mints them; see src/utils/security.py). REQUIRED, no
# default: generate a real random value per environment, e.g.
# `python -c "import secrets; print(secrets.token_urlsafe(48))"` — never
# reuse the same secret across environments.
JWT_SECRET=
JWT_EXPIRY_HOURS=12

# SECURITY: must be false (the default) everywhere except local dev. When
# true, any request with no bearer token is treated as ADMIN — never set
# this in a shared/staging/production environment.
DEV_AUTH_BYPASS=false

# Legacy Entra SSO scaffold (GET /auth/callback) — dormant now that there's
# no gateway fronting an SSO redirect. Leave unset unless that's wired up
# again later.
GATEWAY_CALLBACK_SECRET=

# AI-assisted email drafts / call prep (src/services/llm_client.py). Optional
# — leave COHERE_API_KEY unset and those two endpoints just 503 with a clear
# "not configured" message instead of failing startup. Get a free-tier key
# at https://dashboard.cohere.com/api-keys.
COHERE_API_KEY=
COHERE_MODEL=command-r-08-2024

# Outbound email sending (src/services/email_client.py) — the "click send"
# half of AI drafting. Optional, same treatment as COHERE_API_KEY above.
# Works with almost any mailbox's SMTP relay (O365, Gmail Workspace,
# SendGrid's SMTP endpoint, ...).
# For real Gmail sending: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587,
# SMTP_USERNAME=<the sending mailbox>, SMTP_PASSWORD=<a Google App Password
# for that mailbox — requires 2-Step Verification on, generated at
# myaccount.google.com/apppasswords>, SMTP_FROM_ADDRESS=<same mailbox>.
# (Domain-wide delegation via a GCP service account was tried and doesn't
# work in this org — its IAM policy blocks both service-account key
# creation and signBlob-based remote signing, which delegation needs one of.)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=

# Outbound SMS sending (src/services/sms_service.py) — the SMS action on a
# Lead's Cadence Activity tab. Optional, same treatment as SMTP_HOST above:
# leave unset and POST /leads/{id}/sms just returns a clear 503 ("not
# configured") instead of failing startup. Get these from the Twilio
# Console (https://console.twilio.com) — TWILIO_FROM_NUMBER must be a
# Twilio-provisioned, SMS-capable number in E.164 format (e.g. +15551234567).
TWILIO_ACCOUNT_SID= 
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+17372212163

# Outbound WhatsApp sending (src/integrations/twilio_whatsapp.py) — shares
# TWILIO_ACCOUNT_SID/TWILIO_AUTH_TOKEN above (one Twilio account for SMS,
# WhatsApp and Voice). Same "optional, validated at call-time" treatment:
# leave unset and POST /leads/{id}/whatsapp just returns a clear 503
# instead of failing startup.
TWILIO_WHATSAPP_FROM=+17372508034
# Required for webhook signature verification against a public URL (e.g. an
# ngrok tunnel) — leave unset for now if you're not receiving inbound
# webhooks yet.
TWILIO_PUBLIC_BASE_URL=
# Kill switch for the two WhatsApp webhook routes — set true only once
# TWILIO_PUBLIC_BASE_URL points somewhere Twilio can actually reach.
WHATSAPP_WEBHOOK_ENABLED=false

# Inbound email-to-lead (src/services/inbound_email_client.py) — use a
# DEDICATED mailbox here, never the same one as SMTP_USERNAME above. An
# actively-used inbox has real historical mail that "process everything
# unseen" will churn through the first time this runs (and mark as read as
# a side effect) — a fresh mailbox never has that backlog. Same App
# Password mechanism as outbound (2-Step Verification on, generated at
# myaccount.google.com/apppasswords). Polled via POST /email-intake/poll,
# meant to be hit on a schedule (e.g. Cloud Scheduler), not by a person.
IMAP_HOST=
IMAP_PORT=993
IMAP_USERNAME=
IMAP_PASSWORD=

# Shared secret POST /email-intake/poll requires in every environment (not
# just prod) since every call creates real data — generate one the same way
# as JWT_SECRET: `python -c "import secrets; print(secrets.token_urlsafe(32))"`
EMAIL_INTAKE_SECRET=

# Shared secret POST /cadence/advance-due-steps (the Sales Cadence scheduler
# tick — auto-resolves due BREAK/FOLLOW_UP steps) requires in every
# environment, same treatment as EMAIL_INTAKE_SECRET above. Meant to be hit
# on a schedule (e.g. Cloud Scheduler), not by a person.
CADENCE_SCHEDULER_SECRET=
